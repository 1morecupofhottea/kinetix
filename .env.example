# Kinetix server configuration. Copy to `.env` and edit.
# `.env` is loaded automatically at startup (and is gitignored).

# Bind address. Kinetix listens on localhost only; put cloudflared in front for
# public access. Use 0.0.0.0:8080 only inside a trusted container network.
KINETIX_BIND=127.0.0.1:8080

# Master key for encrypting upstream credentials at rest (AES-256-GCM).
# Accepts 64 hex chars, base64, or a >=16-char passphrase (hashed to 32 bytes).
# Generate one with:  openssl rand -hex 32
KINETIX_MASTER_KEY=change-me-generate-with-openssl-rand-hex-32

# Admin console password (min 8 chars). The dashboard session cookie is derived
# from this, so rotating it invalidates all existing sessions.
KINETIX_ADMIN_TOKEN=change-me-admin-password

# SQLite database. WAL mode is enabled automatically.
KINETIX_DATABASE_URL=sqlite://kinetix.db

# Optional: seed the database on first run from a TOML file (see
# config.toml.example). Ignored once the database has providers.
KINETIX_BOOTSTRAP_FILE=config.toml

# JSON logs (true) or compact human-readable logs (false).
KINETIX_LOG_JSON=false

# --- Optional --------------------------------------------------------------

# Public base URL (used for links/redirects behind a tunnel).
# KINETIX_PUBLIC_BASE_URL=https://llm.example.com

# Data directory for local state (defaults to the working directory).
# KINETIX_DATA_DIR=/var/lib/kinetix

# --- Cloudflare Access (admin API protection) ------------------------------
# When set, the admin API requires a valid Cloudflare Access JWT (validated
# in-process against the team's JWKS) in addition to the session cookie.
# KINETIX_CF_ACCESS_AUD=
# KINETIX_CF_ACCESS_TEAM_DOMAIN=

# --- Development only ------------------------------------------------------
# Allow http:// and private/internal upstream endpoints (SSRF guard bypass).
# KINETIX_ALLOW_PRIVATE_UPSTREAMS=false
