# Copy to `.env` next to docker-compose.yml and fill in what you need.
# Every value is optional — Kinetix generates and persists what it can.

# 64-hex, base64 (32 bytes), or a >=16-char passphrase used to encrypt upstream
# credentials at rest. Leave unset to have one generated on first start.
KINETIX_MASTER_KEY=

# Dashboard/admin password. Leave unset to have `kinetix init` generate one and
# print it once in the container logs:
#   docker compose logs kinetix | grep -i password
KINETIX_ADMIN_TOKEN=

# Development only — do not enable in production.
KINETIX_ALLOW_PRIVATE_UPSTREAMS=false
KINETIX_ALLOW_INSECURE_TLS=false

# Optional webhook for alerting (FR-6.6).
KINETIX_ALERT_WEBHOOK_URL=

# Optional Cloudflare Tunnel token (only needed for `--profile tunnel`).
TUNNEL_TOKEN=
